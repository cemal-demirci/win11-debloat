<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Win11-Debloat</AssemblyName>
    <RootNamespace>CemalCloud.Win11Debloat</RootNamespace>
    <!-- Always 64-bit on 64-bit Windows: the scripts must see the 64-bit registry. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>Cemal.cloud</Company>
    <Product>Windows 11 Debloat</Product>
    <Description>Windows 11 Debloat by Cemal.cloud</Description>
    <Copyright>Copyright (c) 2026 Cemal Demirci</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- .NET Framework 4.8 reference assemblies, so the build needs no targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tested scripts from the repository root, embedded unchanged -->
    <EmbeddedResource Include="..\Win11-Debloat.ps1" LogicalName="Win11-Debloat.ps1" />
    <EmbeddedResource Include="..\Win11-Restore.ps1" LogicalName="Win11-Restore.ps1" />
  </ItemGroup>

</Project>
